<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.studypath.localhost</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/Users/macbook/.studypath-server/static-server.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/macbook/.studypath-server</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/macbook/.studypath-server/studypath.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/macbook/.studypath-server/studypath.err.log</string>
</dict>
</plist>
